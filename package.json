{
  "name": "t3-designer",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm demo",
    "demo": "pnpm --filter @t3-designer/web dev",
    "dev:full": "node --env-file-if-exists=.env scripts/dev-full.mjs",
    "dev:web": "pnpm --filter @t3-designer/web dev",
    "dev:api": "pnpm --filter @t3-designer/api dev",
    "start:api": "pnpm --filter @t3-designer/api start",
    "build": "turbo run build",
    "build:demo": "pnpm --filter @t3-designer/web build",
    "build:full": "pnpm --filter @t3-designer/web build:full",
    "local:setup": "node scripts/setup-local.mjs",
    "local:up": "docker compose --env-file deploy/local/.env up --build -d",
    "local:down": "docker compose --env-file deploy/local/.env down",
    "local:logs": "docker compose --env-file deploy/local/.env logs --tail=100 -f",
    "local:account": "docker compose --env-file deploy/local/.env exec api node apps/api/src/account-cli.ts",
    "lint": "turbo run lint && eslint scripts",
    "typecheck": "turbo run typecheck && tsc --project scripts/tsconfig.json",
    "test": "turbo run test && node --test scripts/test/*.test.ts && python3 -m unittest discover -s scripts/blender/tests",
    "blender:check": "uv run scripts/blender/check_mcp.py",
    "blender:sample": "node scripts/run_blender.mjs create_door_frame.py",
    "scene:snapshot": "node scripts/export_scene.ts",
    "blender:assets": "node scripts/run_blender.mjs create_current_assets.py",
    "blender:generate": "node scripts/run_blender.mjs generate_asset.py",
    "blender:apartment": "pnpm scene:snapshot && node scripts/run_blender.mjs assemble_apartment.py",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm scene:verify && pnpm build && pnpm audit:dist",
    "scene:verify": "node scripts/export_scene.ts --check",
    "blender:validate": "python3 scripts/blender/validate_assets.py --report artifacts/reports/assets.json",
    "blender:scene": "node scripts/run_blender.mjs assemble_project.py",
    "blender:render": "node scripts/run_blender.mjs assemble_project.py --render",
    "test:e2e": "pnpm --filter @t3-designer/web test:e2e",
    "test:e2e:fast": "pnpm --filter @t3-designer/web test:e2e:fast",
    "test:e2e:webgl": "pnpm --filter @t3-designer/web test:e2e:webgl",
    "test:analytics": "pnpm --filter @t3-designer/web exec playwright test --config playwright.analytics.config.ts",
    "test:demo": "pnpm --filter @t3-designer/web test:demo",
    "check:all": "pnpm audit:history && pnpm check && pnpm test:e2e && pnpm test:analytics && pnpm test:accounts && pnpm test:demo",
    "account": "pnpm --filter @t3-designer/api account",
    "test:accounts": "pnpm --filter @t3-designer/web test:accounts",
    "audit:public": "node scripts/audit_public_artifacts.mjs",
    "audit:dist": "node scripts/audit_public_artifacts.mjs --build apps/web/dist",
    "audit:history": "node scripts/audit_public_history.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "turbo": "^2.11.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "@types/node": "^24.13.6",
    "@t3-designer/scene-schema": "workspace:*",
    "@t3-designer/geometry": "workspace:*"
  }
}
