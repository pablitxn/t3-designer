# Local development: pnpm dev:full opens this exact origin.
T3_PUBLIC_URL=http://127.0.0.1:5173
T3_API_HOST=127.0.0.1
T3_API_PORT=8787

# Production requires NODE_ENV=production, an HTTPS public URL, a dedicated
# PostgreSQL database/role, and an independently generated >=32-character secret.
# T3_DATABASE_URL=postgresql://t3_user:password@postgresql:5432/t3_designer
# T3_AUTH_SECRET=
# T3_ACCOUNT_DATA_DIR=artifacts/accounts
# T3_ASSET_DATA_DIR=artifacts/asset-library
# Exact IPs of the proxy hops you operate; empty ignores X-Forwarded-For.
# Each trusted proxy must append its verified peer IP or replace untrusted input.
# Do not enter public clients, CIDRs, hostnames or wildcard ranges.
T3_TRUSTED_PROXY_IPS=

# Inference is opt-in and metered for every authenticated account.
T3_GENERATION_ENABLED=false
T3_GENERATION_DAILY_LIMIT=5
T3_GENERATION_GLOBAL_DAILY_LIMIT=20
T3_GENERATION_PENDING_LIMIT=2
# Artifact budget on the private volume; reserve 256 MiB before each render.
T3_LIBRARY_MAX_MIB=1536

# Public inference uses the hosted OpenAI Responses API; never put secrets in VITE_*.
# The local Codex adapter is retained for private operator use only.
T3_INFERENCE_PROVIDER=openai
# OPENAI_API_KEY= (configure privately, never commit)
T3_OPENAI_MODEL=gpt-5.4
T3_TRIAL_DAYS=15
T3_TRIAL_CREDITS=100
T3_PREMIUM_MONTHLY_CREDITS=1000
T3_CREDIT_COST_ASSET=20
T3_CREDIT_COST_REVISION=10
T3_CREDIT_COST_PROJECT=50
T3_CREDIT_COST_BUILDING=100
T3_CREDIT_COST_APARTMENT=50

# disabled | sandbox. mock is explicitly local-only and never contacts Mercado Pago.
T3_BILLING_MODE=disabled
T3_MONTHLY_AMOUNT_ARS=10000
T3_MONTHLY_CREDITS=500
T3_SMALL_PACK_AMOUNT_ARS=3000
T3_SMALL_PACK_CREDITS=100
T3_LARGE_PACK_AMOUNT_ARS=12000
T3_LARGE_PACK_CREDITS=500
# Sandbox requires a test seller, test buyer, webhook signature secret, and HTTPS.
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# MP_SANDBOX_PAYER_EMAIL=
