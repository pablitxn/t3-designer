# Generated secrets go in the ignored sibling .env via pnpm local:setup.
# The reference stack is local-only; only the web port is published on loopback.
T3_WEB_PORT=8080
T3_POSTGRES_PASSWORD=
T3_AUTH_SECRET=
T3_GENERATION_ENABLED=false
T3_OPENAI_MODEL=gpt-5.4
OPENAI_API_KEY=
T3_LIBRARY_MAX_MIB=1536
