{
  "name": "@t3-designer/web",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode demo",
    "build": "vite build --mode demo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --grep-invert @webgl --workers=1",
    "test:e2e:webgl": "playwright test --grep @webgl --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:accounts": "node --test test/private-auth.browser.ts",
    "dev:full": "vite --mode full",
    "build:full": "vite build --mode full",
    "test:demo": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@t3-designer/asset-schema": "workspace:*",
    "@t3-designer/geometry": "workspace:*",
    "@t3-designer/scene-schema": "workspace:*",
    "i18next": "26.4.2",
    "maplibre-gl": "6.11.2",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-i18next": "17.0.15",
    "three": "^0.186.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "4.3.3",
    "vite": "^8.3.1"
  }
}
